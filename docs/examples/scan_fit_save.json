          }
        },
        {
          "plugin": {
            "type": "command",
            "class": "stoner_measurement.plugins.command.save:SaveCommand",
            "instance_name": "save_traces",
            "path_expr": "f'guide/trace_{scan.ix:03d}.txt'",
            "trace_selection": {
              "scan.data": false,
              "iv:Dummy": true,
              "filter_:filtered": true,
              "curve_fit:initial_fit": false,
              "curve_fit:best_fit": true
            },
            "no_overwrite": true,
            "save_format": "tdi",
            "incremental_save": false
          }
        },
        {
          "plugin": {
            "type": "command",
            "class": "stoner_measurement.plugins.command.save:SaveCommand",
            "instance_name": "save_live",
            "path_expr": "'guide/scan_live.txt'",
            "trace_selection": {
              "scan.data": true,
